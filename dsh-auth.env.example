# Copy this file to dsh-auth.env. Never commit the real file.
# Generate the hash with:
# node packages/dsh-user-auth/lib/hash-invite.js "your invite code"
DSH_REGISTRATION_INVITE_HASH=replace-with-argon2id-hash
DSH_AUTH_DATABASE_PATH=D:\dsh-app\.dsh\auth.sqlite
# Use false only for local plain HTTP. Set true behind HTTPS.
DSH_AUTH_SECURE_COOKIE=false
