# Local API-VLM configuration for Data-Juicer plan-flow MCP.
# Copy this file to dj-plan-flow.env and fill in your own values.
# Keep dj-plan-flow.env private; it is ignored by Git.
# web-dj.ps1 starts in native mode by default. Pass -ExecutionMode broker
# when a Runtime Resolver and loopback Broker are deployed.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DJ_VLM_MODEL=qwen3.7-plus

# Alternatives supported by Data-Juicer:
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=
# OPENAI_API_URL=
