# Copy this file to loongsuite-langfuse.env and fill in the values from
# Langfuse project settings. Never commit the populated file.

# EU:    https://cloud.langfuse.com/api/public/otel
# US:    https://us.cloud.langfuse.com/api/public/otel
# Japan: https://jp.cloud.langfuse.com/api/public/otel
LANGFUSE_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
